    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.8",
    "metro": "^0.83.1",
    "metro-config": "^0.81.0",
    "metro-resolver": "^0.81.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
